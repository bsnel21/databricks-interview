{
  "datasets": [
    {
      "catalog": "databricks_interview",
      "displayName": "Daily revenue by region",
      "name": "daily_revenue",
      "queryLines": [
        "SELECT order_date, region, order_count, gross_revenue, net_revenue, net_revenue_vs_region_average,\n",
        "  AVG(net_revenue) OVER (PARTITION BY region ORDER BY unix_timestamp(order_date) RANGE BETWEEN 345600 PRECEDING AND CURRENT ROW) AS net_revenue_5d_avg\n",
        "FROM gold.gold_daily_revenue"
      ]
    }
  ],
